  m_Script: {fileID: 11500000, guid: edadc97d37b3807439148cfeb126fd1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogoApenas
  textoDialogoUI: {fileID: 1983366125}
  painelDialogoUI: {fileID: 1208268732}
  avisoInteracaoUI: {fileID: 0}
  falas:
  - "Tiny\n\n Ralph! Que bom que voc\xEA chegou!"
  - "Ralph\n\nEae Tin- que cheiro \xE9 esse?"
  - "Tiny\n\nAh, sobre isso\u2026 Voc\xEA trabalha tanto e eu queria ajudar um pouquinho.
    Vi essa alavanca quebrada e decidi tentar consertar, mas a\xED apareceram uns
    ratos e eu peguei um dos inseticidas-"
  - 'Ralph


    Tentou matar um rato com inseticida? Para insetos?'
  - "Tiny\n\nFuncionou! Mas a\xED eu n\xE3o vi que o quadro estava ligado e quando
    eu olhei pra tr\xE1s\u2026 Kabum! Desculpa, Ralph\u2026"
  - 'Ralph - pensamento


    por que sempre sobra tudo para mim?'
  - "Tiny\n\nVeja pelo lado bom, Larry e eu j\xE1 apagamos o fogo!"
  teclaInteracao: 101
